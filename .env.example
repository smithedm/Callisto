# Azure Authentication via Service Principal
# Copy this file to .env and fill in your credentials
# NEVER commit .env to git (it's already in .gitignore)

# Your Azure Subscription ID
AZURE_SUBSCRIPTION_ID=your-subscription-id-here

# Service Principal Credentials (if using service principal auth)
AZURE_TENANT_ID=your-tenant-id-here
AZURE_CLIENT_ID=your-client-id-here
AZURE_CLIENT_SECRET=your-client-secret-here

# Note: If you're using Azure CLI, you only need AZURE_SUBSCRIPTION_ID
# The other credentials are only needed for service principal authentication
